%{

%}

%union {
    int ival;
    double dval;
    std::string* sval;
}

%token <ival> INT_LITERAL CHAR_LITERAL
%token <dval> FLOAT_LITERAL
%token <sval> ID STRING_LITERAL

%token VOID CHAR INT FLOAT DOUBLE SHORT LONG BOOL_TYPE
%token STRUCT UNION ENUM
%token ID_TYPE CLASS SEL IMP

%token UMINUS
%token INC
%token DEC
%token EQ
%token NEQ
%token LEQ
%token GEQ
%token AND
%token OR
%token SHL
%token SHR
%token ADD_ASSIGN
%token SUB_ASSIGN
%token MUL_ASSIGN
%token DIV_ASSIGN
%token MOD_ASSIGN
%token AND_ASSIGN
%token OR_ASSIGN   
%token XOR_ASSIGN  
%token SHL_ASSIGN
%token SHR_ASSIGN  
%token ARROW

%token SELF SUPER NIL NIL_CAP
%token YES NO
%token ONEWAY IN OUT INOUT BYCOPY BYREF

%token AUTO BREAK CASE CONST CONTINUE DEFAULT DO ELSE EXTERN
%token FOR GOTO IF INLINE REGISTER RETURN SIGNED SIZEOF 
%token STATIC SWITCH TYPEDEF UNSIGNED VOLATILE WHILE

%token AT_INTERFACE
%token AT_IMPLEMENTATION
%token AT_PROTOCOL
%token AT_END
%token AT_CLASS
%token AT_PUBLIC
%token AT_PROTECTED
%token AT_PRIVATE
%token AT_PACKAGE
%token AT_PROPERTY
%token AT_SYNTHESIZE
%token AT_DYNAMIC
%token AT_SELECTOR
%token AT_ENCODE
%token AT_TRY
%token AT_CATCH
%token AT_FINALLY
%token AT_THROW
%token AT_OPTIONAL
%token AT_REQUIRED
%token AT_SYNCHRONIZED
%token AT_AUTORELEASEPOOL
%token AT_IMPORT
%token AT

%right '=' ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN DIV_ASSIGN MOD_ASSIGN 
        AND_ASSIGN OR_ASSIGN XOR_ASSIGN SHL_ASSIGN SHR_ASSIGN
%right '?' ':'
%left OR
%left AND
%left '|'
%left '^'
%left '&'
%nonassoc EQ NEQ
%nonassoc '<' '>' LEQ GEQ
%left SHL SHR
%left '+' '-'
%left '*' '/' '%'
%right '!' '~' INC DEC UMINUS

%%

type: BOOL_TYPE
    | CHAR
    | SHORT
    | INT
    | LONG
    | FLOAT
    | DOUBLE
    ;

expr: INT_LITERAL
    | FLOAT_LITERAL
    | STRING_LITERAL
    | ID
    | YES
    | NO
    | SELF
    | SUPER
    | NIL
    | NIL_CAP
    | '(' expr ')'
    | expr '+' expr
    | expr '-' expr
    | expr '*' expr
    | expr '/' expr
    | expr '%' expr
    | expr EQ expr
    | expr NEQ expr
    | expr '<' expr
    | expr '>' expr
    | expr LEQ expr
    | expr GEQ expr
    | expr AND expr
    | expr OR expr
    | expr '&' expr
    | expr '|' expr
    | expr '^' expr
    | expr SHL expr
    | expr SHR expr
    | expr '=' expr
    | expr ADD_ASSIGN expr
    | expr SUB_ASSIGN expr
    | expr MUL_ASSIGN expr
    | expr DIV_ASSIGN expr
    | expr MOD_ASSIGN expr
    | expr AND_ASSIGN expr
    | expr OR_ASSIGN expr
    | expr XOR_ASSIGN expr
    | expr SHL_ASSIGN expr
    | expr SHR_ASSIGN expr
    | expr '?' expr ':' expr
    | '-' expr %prec UMINUS
    | '+' expr %prec UMINUS
    | '!' expr
    | '~' expr
    | INC expr
    | DEC expr
    | expr INC
    | expr DEC
    | expr '.' ID    
    | expr ARROW ID
    | expr '[' expr ']'
    | ID '(' expr_list ')'
    ;

expr_list: expr
         | expr_list ',' expr
         ;

expr_list_empty: /*empty*/
               | expr_list
               ;
